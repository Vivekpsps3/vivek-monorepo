# Optional secrets template; the default configuration requires no environment file.
# Set SITE_ENV_FILE to a private external file if optional integrations need keys.
# For make dev, export optional keys in the shell; the Make target does not load .env.
# Runtime settings, mounts, resources and backup schedule are in compose.yml.
FLIGHTAWARE_API_KEY=
TMDB_API_KEY=
RAWG_API_KEY=
