# Copy to .env (gitignored). Compose and _control read this one file.

# --- finance ---
FINANCE_DATA_DIR=/home/vivek/Deployments/vivek-monorepo/data
FINANCE_BACKUP_DIR=/home/vivek/Deployments/vivek-monorepo/backups
DATABASE_URL=sqlite:////data/finance.db
CORS_ORIGINS=https://vivekpanchagnula.com,https://finance.vivekpanchagnula.com
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=none
SESSION_DAYS=7
DISABLE_OPENAPI=1
ALEMBIC_STRICT=1
WEB_PORT=8085
RATE_LIMIT_PER_MIN=60

# --- travel (same origin, path /travel/) ---
# Optional FlightAware AeroAPI key. Leave unset to type flights yourself.
# FLIGHTAWARE_API_KEY=

# --- media (same origin, path /media/) ---
# Optional metadata keys. The journal still works with manual entry when these are unset.
# TMDB_API_KEY=
# RAWG_API_KEY=

# --- site ---
# no secrets; static build via make site-deploy
