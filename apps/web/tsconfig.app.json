{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/web",
    "types": [
      "node"
    ],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.mjs",
    "src/**/*.d.mts",
    "../travel/frontend/src/**/*.ts",
    "../travel/frontend/src/**/*.mjs",
    "../travel/frontend/src/**/*.d.mts",
    "../media/frontend/src/**/*.ts",
    "../media/frontend/src/**/*.mjs",
    "../media/frontend/src/**/*.d.mts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "../travel/frontend/src/**/*.spec.ts",
    "../media/frontend/src/**/*.spec.ts"
  ]
}
