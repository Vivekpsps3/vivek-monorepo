# Copy to apps/travel/backend/.env if you want local overrides.
# The database is separate from finance. Do not point this at finance.db.
TRAVEL_DATABASE_URL=sqlite:///./travel.db
TRAVEL_HOST=0.0.0.0
TRAVEL_PORT=8090

# `make travel-dev` serves this app at / on TRAVEL_PORT. The shared session
# is the suite origin (docker compose: /finance/ and /travel/). Leave the
# mount path empty here.
# FINANCE_API_URL=http://127.0.0.1:8000
# TRAVEL_MOUNT_PATH=

# Optional FlightAware AeroAPI key. The settings page can store one instead.
# A key in the environment wins over a key saved in the database.
# FLIGHTAWARE_API_KEY=
